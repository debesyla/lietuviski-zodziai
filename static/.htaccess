RewriteEngine On

# Preserve real files and directories, including JSON data-product chunks.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Canonical routes have no trailing slash and map to prerendered .html files.
RewriteRule ^(.+)/$ $1 [R=308,L]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
